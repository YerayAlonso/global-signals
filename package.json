{
  "name": "stat-counter-modern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy:cloudflare": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "vendor:sync": "node scripts/vendor.mjs",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "data:check": "tsx scripts/check-live.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/preact": "6.0.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "7.3.5",
    "lucide-preact": "^0.468.0",
    "preact": "^10.29.0",
    "teechart.js": "4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "4.147.0"
  }
}
