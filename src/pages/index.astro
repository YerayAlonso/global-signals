---
import Dashboard from '../components/Dashboard';
import snapshot from '../data/snapshot.json';
import type { Dataset } from '../lib/model';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="description" content="A fresh perspective on the web. Explore browser, operating system, search engine and device market shares with real Statcounter Global Stats data." />
    <meta property="og:title" content="Global Signals — The web, in perspective" />
    <meta property="og:description" content="Real data. Interactive charts. A clearer view of the digital world." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Global Signals — The web, in perspective</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('global-signals-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme || (prefersDark ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Dashboard initial={snapshot as Dataset} client:load />
    <noscript><div class="noscript">Enable JavaScript to explore the filters and charts. The latest market shares are available in the table. <a href="https://gs.statcounter.com/">Visit the original source.</a></div></noscript>
  </body>
</html>
